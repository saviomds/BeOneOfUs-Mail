APP_BASE_URL=https://mail.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mail-service@example.com
SMTP_PASSWORD=replace-with-a-secret
SMTP_FROM=mail-service@example.com
# Generate with: node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('base64'))"
APP_SETTINGS_ENCRYPTION_KEY=
PORT=5000